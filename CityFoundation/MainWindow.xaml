<Window x:Class="CityFoundation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CitySim"
        Width="1200"
        Height="800"
        MinWidth="800"
        MinHeight="600"
        Background="Black"
        WindowStartupLocation="CenterScreen">

    <Canvas x:Name="MapViewport"
            Background="Black"
            ClipToBounds="True">

        <Canvas x:Name="MapContent"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"/>

    </Canvas>
</Window>
